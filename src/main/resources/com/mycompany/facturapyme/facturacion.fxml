<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.facturapyme.FacturacionController">
   <children>
      <Label layoutX="14.0" layoutY="1.0" text="Emisión de Facturas">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Button layoutX="765.0" layoutY="52.0" mnemonicParsing="false" onAction="#nuevaFactura" prefHeight="25.0" prefWidth="113.0" text="+ Nueva Factura" />

      <Label layoutX="14.0" layoutY="29.0" text="N° de Factura" />
      <Label fx:id="lblCodigoFactura" layoutX="11.0" layoutY="56.0" text="FAC-0000 (automático)" />

      <Label layoutX="152.0" layoutY="29.0" text="Fecha" />
      <Label fx:id="lblFecha" layoutX="152.0" layoutY="56.0" text="00/00/0000" />

      <Label layoutX="243.0" layoutY="29.0" text="Cliente" />
      <ComboBox fx:id="cboCliente" layoutX="241.0" layoutY="52.0" prefHeight="25.0" prefWidth="140.0" promptText="Selecciona un cliente" />

      <Label layoutX="432.0" layoutY="29.0" text="Estado" />
      <ComboBox fx:id="cboEstado" layoutX="435.0" layoutY="52.0" prefHeight="25.0" prefWidth="113.0" />

      <Label layoutX="11.0" layoutY="88.0" text="Detalle de la factura">
         <font>
            <Font size="14.0" />
         </font>
      </Label>

      <Label layoutX="11.0" layoutY="119.0" text="Producto:" />
      <ComboBox fx:id="cboProducto" layoutX="11.0" layoutY="136.0" prefHeight="25.0" prefWidth="185.0" promptText="Selecciona un producto" />

      <Label layoutX="236.0" layoutY="119.0" text="Cantidad:" />
      <TextField fx:id="txtCantidad" layoutX="236.0" layoutY="136.0" prefHeight="25.0" prefWidth="150.0" />

      <Button fx:id="btnAgregarLinea" layoutX="519.0" layoutY="136.0" mnemonicParsing="false" onAction="#agregarLinea" prefHeight="25.0" prefWidth="130.0" text="+ Agregar línea" />
      <Button fx:id="btnQuitarLinea" layoutX="720.0" layoutY="136.0" mnemonicParsing="false" onAction="#quitarLinea" prefHeight="25.0" prefWidth="158.0" text="- Quitar línea seleccionada" />

      <TableView fx:id="tblDetalle" layoutX="17.0" layoutY="173.0" prefHeight="298.0" prefWidth="865.0">
        <columns>
          <TableColumn fx:id="colCodigo" prefWidth="116.0" text="Código" />
          <TableColumn fx:id="colProducto" prefWidth="254.0" text="Producto" />
            <TableColumn fx:id="colCantidad" prefWidth="198.0" text="Cantidad" />
            <TableColumn fx:id="colPrecioUnit" prefWidth="152.0" text="Precio Unit." />
            <TableColumn fx:id="colSubtotal" prefWidth="144.0" text="Subtotal" />
        </columns>
      </TableView>

      <Label layoutX="534.0" layoutY="476.0" text="Subtotal:" />
      <Label fx:id="lblSubtotal" layoutX="680.0" layoutY="476.0" text="L. 0.00" />

      <Label layoutX="531.0" layoutY="502.0" text="ISV (15%):" />
      <Label fx:id="lblIsv" layoutX="680.0" layoutY="502.0" text="L. 0.00" />

      <Label layoutX="531.0" layoutY="529.0" text="Total:">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <Label fx:id="lblTotal" layoutX="680.0" layoutY="529.0" text="L. 0.00">
         <font>
            <Font size="14.0" />
         </font>
      </Label>

      <Button layoutX="13.0" layoutY="549.0" mnemonicParsing="false" onAction="#cancelar" prefHeight="30.0" prefWidth="100.0" text="Cancelar" />
      <Button layoutX="136.0" layoutY="549.0" mnemonicParsing="false" onAction="#guardarFactura" prefHeight="30.0" prefWidth="140.0" text="Guardar Factura" />
   </children>
</AnchorPane>
